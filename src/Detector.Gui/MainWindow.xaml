<Window x:Class="Detector.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detector — Defensive malware analysis" Height="640" Width="1040"
        MinHeight="460" MinWidth="820"
        Background="{StaticResource WindowBg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="14,10"
            BorderBrush="{StaticResource BorderBg}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock Text="🛡  Detector" FontSize="18" FontWeight="Bold"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Border Background="{Binding AmsiBrush}" CornerRadius="10" Padding="10,3" Margin="6,0">
            <TextBlock Text="{Binding AmsiStatus}" FontSize="12"/>
          </Border>
          <Border Background="{Binding AdminBrush}" CornerRadius="10" Padding="10,3" Margin="6,0">
            <TextBlock Text="{Binding AdminStatus}" FontSize="12"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource PanelBg}" Padding="8,6"
            BorderBrush="{StaticResource BorderBg}" BorderThickness="0,0,0,1">
      <WrapPanel>
        <Button Content="📄  Scan file"       Command="{Binding ScanFileCommand}"/>
        <Button Content="📁  Scan folder"      Command="{Binding ScanFolderCommand}"/>
        <Button Content="⚡  Scan PowerShell"  Command="{Binding ScanPsCommand}"/>
        <Button Content="🧪  Self-test"        Command="{Binding SelftestCommand}"/>
        <Button Content="{Binding WatchButtonText}" Command="{Binding ToggleWatchCommand}"/>
        <CheckBox Content="Aggressive (RunPE)" IsChecked="{Binding Aggressive}"/>
        <CheckBox Content="FP-Filter" IsChecked="{Binding FilterFps}"
                  ToolTip="Signature, JIT, and duplicate-result filter"/>
        <CheckBox Content="Advanced" IsChecked="{Binding Advanced}"
                  ToolTip="Show raw telemetry and filtered findings as trace lines"/>
        <Border Width="1" Background="{StaticResource BorderBg}" Margin="6,2"/>
        <Button Content="🧹  Clear"           Command="{Binding ClearCommand}"/>
        <Button Content="💾  Export JSONL"    Command="{Binding ExportCommand}"/>
      </WrapPanel>
    </Border>

    <TabControl Grid.Row="2" Margin="8" Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource BorderBg}">

      <TabItem Header="Results">
        <DataGrid ItemsSource="{Binding Results}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time"        Binding="{Binding Time}"     Width="Auto"/>
            <DataGridTextColumn Header="Source"      Binding="{Binding Source}"   Width="Auto"/>
            <DataGridTextColumn Header="Verdict"     Binding="{Binding Verdict}"  Width="Auto"/>
            <DataGridTextColumn Header="Severity"    Binding="{Binding Severity}" Width="Auto"/>
            <DataGridTextColumn Header="Rule"        Binding="{Binding Rule}"     Width="180"/>
            <DataGridTextColumn Header="Target"      Binding="{Binding Target}"   Width="2*"/>
            <DataGridTextColumn Header="Details"     Binding="{Binding Details}"  Width="3*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Processes">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="🔄  Refresh"       Command="{Binding RefreshProcCommand}"/>
            <Button Content="🔎  Scan selected" Command="{Binding ScanSelectedProcCommand}"/>
            <Button Content="🔎  Scan all"      Command="{Binding ScanAllProcCommand}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="PID"     Binding="{Binding Pid}"  Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="{StaticResource HeaderBg}" Padding="14,7"
            BorderBrush="{StaticResource BorderBg}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubtleFg}"
                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
