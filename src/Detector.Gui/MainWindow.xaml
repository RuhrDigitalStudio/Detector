<Window x:Class="Detector.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:Detector.Model;assembly=Detector.Core"
        Title="Detector — Analysis workbench" Width="1180" Height="760"
        MinWidth="960" MinHeight="620" Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
            BorderBrush="{StaticResource BorderBg}" BorderThickness="0,0,1,0" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="DETECTOR" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="DEFENSIVE ANALYSIS" Foreground="{StaticResource SubtleFg}" FontSize="10" Margin="0,4,0,22"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="NEW CASE" Foreground="{StaticResource SubtleFg}" FontSize="10" Margin="0,0,0,8"/>
          <Button Content="Analyze file" Style="{StaticResource PrimaryButton}" Click="AnalyzeFile_Click"
                  IsEnabled="{Binding NotBusy}"/>
          <Button Content="Analyze folder" Click="AnalyzeFolder_Click" IsEnabled="{Binding NotBusy}"/>
          <Button Content="Import runtime trace" Click="ImportTrace_Click" IsEnabled="{Binding NotBusy}"
                  ToolTip="Imports JSONL evidence exported by Sysmon or another sensor; no sample is executed."/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,24,0,8">
          <TextBlock Text="LIVE SENSORS" Foreground="{StaticResource SubtleFg}" FontSize="10" Margin="0,0,0,8"/>
          <Button Content="{Binding WatchButtonText}" Command="{Binding ToggleWatchCommand}"/>
          <TextBlock Text="Static analysis never launches a selected sample. Live monitoring only observes activity already occurring on this host."
                     Foreground="{StaticResource SubtleFg}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <Border Background="{Binding AmsiBrush}" CornerRadius="5" Padding="9,6" Margin="0,0,0,6">
            <TextBlock Text="{Binding AmsiStatus}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </Border>
          <Border Background="{Binding AdminBrush}" CornerRadius="5" Padding="9,6">
            <TextBlock Text="{Binding AdminStatus}" FontSize="11"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="22,18,22,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,15">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding CaseTitle}" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding AssessmentSummary}" Foreground="{StaticResource SubtleFg}"
                     Margin="0,5,20,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Export JSON" Margin="0,0,8,0" Click="ExportJson_Click" IsEnabled="{Binding HasCase}"/>
          <Button Content="Export HTML" Margin="0" Click="ExportHtml_Click" IsEnabled="{Binding HasCase}"/>
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,15">
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBg}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,8,0">
          <StackPanel><TextBlock Text="ASSESSMENT" Foreground="{StaticResource SubtleFg}" FontSize="10"/>
            <TextBlock Text="{Binding AssessmentLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBg}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,8,0">
          <StackPanel><TextBlock Text="ARTIFACTS" Foreground="{StaticResource SubtleFg}" FontSize="10"/>
            <TextBlock Text="{Binding ArtifactCount}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBg}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,8,0">
          <StackPanel><TextBlock Text="INDICATORS" Foreground="{StaticResource SubtleFg}" FontSize="10"/>
            <TextBlock Text="{Binding IndicatorCount}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBg}" BorderThickness="1"
                CornerRadius="6" Padding="14">
          <StackPanel><TextBlock Text="COVERAGE GAPS" Foreground="{StaticResource SubtleFg}" FontSize="10"/>
            <TextBlock Text="{Binding CoverageGapCount}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        </Border>
      </UniformGrid>

      <TabControl Grid.Row="2">
        <TabItem Header="Findings">
          <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter rule, target, source, or details"/>
              <ComboBox Grid.Column="1" Margin="8,0,0,0" SelectedValuePath="Tag"
                        SelectedValue="{Binding MinimumSeverity}" ToolTip="Minimum severity">
                <ComboBoxItem Tag="{x:Static model:Severity.Info}"><TextBlock Text="Info and above" Foreground="#121820"/></ComboBoxItem>
                <ComboBoxItem Tag="{x:Static model:Severity.Low}"><TextBlock Text="Low and above" Foreground="#121820"/></ComboBoxItem>
                <ComboBoxItem Tag="{x:Static model:Severity.Medium}"><TextBlock Text="Medium and above" Foreground="#121820"/></ComboBoxItem>
                <ComboBoxItem Tag="{x:Static model:Severity.High}"><TextBlock Text="High and above" Foreground="#121820"/></ComboBoxItem>
                <ComboBoxItem Tag="{x:Static model:Severity.Critical}"><TextBlock Text="Critical only" Foreground="#121820"/></ComboBoxItem>
              </ComboBox>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}">
              <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{Binding RowBrush}"/></Style></DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="190"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Background="{StaticResource SidebarBg}" Padding="10" Margin="0,8,0,0" CornerRadius="4">
              <TextBlock Text="{Binding SelectedFinding.Details, Mode=OneWay}" Foreground="{StaticResource SubtleFg}"
                         TextWrapping="Wrap" MaxHeight="60"/>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Capabilities">
          <DataGrid ItemsSource="{Binding Capabilities}" Margin="8">
            <DataGrid.Columns><DataGridTextColumn Header="Capability" Binding="{Binding Title}" Width="180"/>
              <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
              <DataGridTextColumn Header="Why" Binding="{Binding Explanation}" Width="3*"/>
              <DataGridTextColumn Header="Supporting rules" Binding="{Binding Evidence}" Width="2*"/></DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Indicators">
          <DataGrid ItemsSource="{Binding Indicators}" Margin="8">
            <DataGrid.Columns><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
              <DataGridTextColumn Header="Sources" Binding="{Binding Sources}" Width="*"/>
              <DataGridTextColumn Header="Context" Binding="{Binding Contexts}" Width="2*"/></DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Artifacts">
          <DataGrid ItemsSource="{Binding Artifacts}" Margin="8">
            <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="85"/>
              <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="100"/>
              <DataGridTextColumn Header="Framework" Binding="{Binding Framework}" Width="130"/>
              <DataGridTextColumn Header="Trust" Binding="{Binding Trust}" Width="140"/>
              <DataGridTextColumn Header="Entropy" Binding="{Binding Entropy}" Width="75"/>
              <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/></DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Timeline">
          <DataGrid ItemsSource="{Binding Timeline}" Margin="8">
            <DataGrid.Columns><DataGridTextColumn Header="Time (UTC)" Binding="{Binding Time}" Width="145"/>
              <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="130"/>
              <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="180"/>
              <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="150"/>
              <DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="*"/></DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Coverage">
          <DataGrid ItemsSource="{Binding Coverage}" Margin="8">
            <DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="2*"/>
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*"/></DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Live">
          <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{Binding WatchButtonText}" Command="{Binding ToggleWatchCommand}" Margin="0,0,8,0"/>
              <Button Content="Clear live findings" Command="{Binding ClearLiveCommand}" Margin="0,0,12,0"/>
              <CheckBox Content="FP filter" IsChecked="{Binding FilterFps}" Margin="0,0,12,0"/>
              <CheckBox Content="Show trace" IsChecked="{Binding Advanced}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding LiveFindings}">
              <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{Binding RowBrush}"/></Style></DataGrid.RowStyle>
              <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="180"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*"/></DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Processes">
          <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Refresh" Command="{Binding RefreshProcCommand}" Margin="0,0,8,0"/>
              <Button Content="Inspect selected" Command="{Binding ScanSelectedProcCommand}" Margin="0,0,8,0"/>
              <Button Content="Inspect all" Command="{Binding ScanAllProcCommand}" Margin="0,0,12,0"/>
              <CheckBox Content="Aggressive heuristics" IsChecked="{Binding Aggressive}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
              <DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="120"/></DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>

      <Grid Grid.Row="3" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubtleFg}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="1" Height="4" Margin="12,0" IsIndeterminate="True" VerticalAlignment="Center">
          <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></ProgressBar.Style>
        </ProgressBar>
        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Margin="0" Padding="10,4"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
